{{template "base/head" .}}
{{$data := .PullStackData}}
<div role="main" class="page-content repository">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="flex-text-block tw-mb-4"><h1 class="tw-text-xl tw-mb-0">{{ctx.Locale.Tr "repo.pulls.stack_number" $data.Stack.ID}}</h1>
			<span class="ui label">{{$data.Stack.State}}</span>{{template "repo/stack/mode_label" $data.Stack}}<span class="tw-text-text-light">{{ctx.Locale.Tr "repo.pulls.stack_base" $data.Stack.TrunkBranch}}</span></div>
		<div class="ui stackable grid tw-max-w-full">
			<div class="eleven wide column tw-min-w-0">
				<ol class="ui segments tw-pl-0" aria-label="{{ctx.Locale.Tr "repo.pulls.stack_entries"}}">
				{{range $data.Entries}}<li class="ui segment flex-left-right tw-flex-wrap tw-max-w-full"><div class="flex-text-block tw-min-w-0"><span>{{.Entry.Position}}.</span>{{if .Pull.HasMerged}}{{svg "octicon-git-merge" 16 "tw-text-purple"}}{{else}}{{svg "octicon-git-pull-request" 16}}{{end}}<div class="tw-min-w-0"><a class="tw-break-anywhere" href="{{.Pull.Issue.Link}}">#{{.Pull.Index}} {{.Pull.Issue.Title}}</a><div class="tw-text-text-light tw-text-12">{{.Pull.HeadBranch}} → {{.Pull.BaseBranch}}</div></div></div><div class="flex-text-block">{{if .Readiness}}<span class="ui basic red label">{{ctx.Locale.Tr "repo.pulls.stack_blocked"}}</span><span class="tw-text-red tw-break-anywhere">{{.Readiness}}</span>{{end}}<span class="ui label">{{if .Pull.HasMerged}}{{ctx.Locale.Tr "repo.pulls.merged"}}{{else if .Pull.Issue.IsClosed}}{{ctx.Locale.Tr "repo.pulls.closed"}}{{else}}{{ctx.Locale.Tr "repo.issues.open_title"}}{{end}}</span></div></li>{{end}}
				</ol><div class="tw-text-text-light">{{ctx.Locale.Tr "repo.pulls.stack_base" $data.Stack.TrunkBranch}}</div>
			</div>
			<div class="five wide column tw-min-w-0">
				{{template "repo/stack/status" .}}
				{{if $data.Operations}}<div class="ui segment"><h3>{{ctx.Locale.Tr "repo.pulls.stack_history"}}</h3>
					<ul class="tw-pl-5">{{range $data.Operations}}<li>{{ctx.Locale.Tr "repo.pulls.stack_operation" .State}} {{if gt .Completed 0}}({{ctx.Locale.Tr "repo.pulls.stack_landed" .Completed}}){{end}}</li>{{end}}</ul></div>{{end}}
				{{if .CanManageStack}}
				{{if $data.LandingStyles}}<form class="ui segment form" method="post" action="{{.RepoLink}}/pulls/stacks/{{$data.Stack.ID}}/land"><input type="hidden" name="stack_version" value="{{$data.Stack.Revision}}"><h3>{{ctx.Locale.Tr "repo.pulls.stack_land"}}</h3>
					<div class="field"><label for="stack-through">{{ctx.Locale.Tr "repo.pulls.stack_land_through"}}</label><select id="stack-through" name="through">{{range $data.Entries}}{{if not .Pull.HasMerged}}<option value="{{.Entry.Position}}">#{{.Pull.Index}}</option>{{end}}{{end}}</select></div><div class="field"><label for="stack-style">{{ctx.Locale.Tr "repo.pulls.stack_merge_style"}}</label><select id="stack-style" name="merge_style">{{range $data.LandingStyles}}<option value="{{.}}">{{if eq . "merge"}}{{ctx.Locale.Tr "repo.pulls.stack_merge_commit"}}{{else if eq . "squash"}}{{ctx.Locale.Tr "repo.pulls.squash_merge_pull_request"}}{{else if eq . "rebase"}}{{ctx.Locale.Tr "repo.pulls.rebase_merge_pull_request"}}{{else}}{{ctx.Locale.Tr "repo.pulls.fast_forward_only_merge_pull_request"}}{{end}}</option>{{end}}</select></div><p class="help">{{ctx.Locale.Tr "repo.pulls.stack_land_desc"}}</p><button type="submit" class="ui primary button">{{ctx.Locale.Tr "repo.pulls.stack_land"}}</button></form>{{else}}
				<div class="ui segment">
					<h3>{{ctx.Locale.Tr "repo.pulls.stack_land"}}</h3>
					<p>{{ctx.Locale.Tr "repo.pulls.stack_land_no_styles"}}</p>
				</div>
				{{end}}
				{{$merge := eq $data.Stack.Mode "merge"}}
				<form class="ui segment form" method="post" action="{{.RepoLink}}/pulls/stacks/{{$data.Stack.ID}}/{{if $merge}}update{{else}}rebase{{end}}"><input type="hidden" name="stack_version" value="{{$data.Stack.Revision}}"><h3>{{ctx.Locale.Tr "repo.pulls.stack_update"}}</h3>
					<p class="help">{{if $merge}}{{ctx.Locale.Tr "repo.pulls.stack_update_merge_desc"}}{{else}}{{ctx.Locale.Tr "repo.pulls.stack_update_rebase_desc"}}{{end}}</p>
					<button type="submit" class="ui button">{{if $merge}}{{ctx.Locale.Tr "repo.pulls.stack_update_merge"}}{{else}}{{ctx.Locale.Tr "repo.pulls.stack_rebase"}}{{end}}</button></form>
				{{if .CanInsertStack}}<form class="ui segment form" method="post" action="{{.RepoLink}}/pulls/stacks/{{$data.Stack.ID}}/insert" data-global-init="initRepoStackInsert"><input type="hidden" name="stack_version" value="{{$data.Stack.Revision}}"><h3>{{ctx.Locale.Tr "repo.pulls.stack_insert"}}</h3>
					{{if .InsertCandidates}}<div class="field"><label for="stack-insert">{{ctx.Locale.Tr "repo.pulls.stack_insert_pull"}}</label>
						<div class="ui search selection dropdown">
							<input type="hidden" name="pull">
							<input id="stack-insert" class="search" autocomplete="off">
							<div class="default text gt-ellipsis tw-max-w-full">{{ctx.Locale.Tr "repo.pulls.stack_top_none"}}</div>
							{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<div class="menu">
								{{range .InsertCandidates}}<div class="item tw-flex tw-flex-col" data-value="{{.Pull.Index}}"><span class="tw-break-anywhere">#{{.Pull.Index}} {{.Pull.Issue.Title}}</span> <span class="tw-text-text-light tw-text-12 tw-break-anywhere">{{.Pull.HeadBranch}} → {{.Pull.BaseBranch}} · {{if .After}}{{ctx.Locale.Tr "repo.pulls.stack_insert_after" .After.Index}}{{else}}{{ctx.Locale.Tr "repo.pulls.stack_insert_bottom"}}{{end}}</span></div>{{end}}
							</div>
						</div>
					</div>
					<p class="help">{{ctx.Locale.Tr "repo.pulls.stack_insert_desc"}}</p>
					<button type="submit" class="ui button" disabled>{{ctx.Locale.Tr "repo.pulls.stack_insert"}}</button>{{else}}<p class="help">{{ctx.Locale.Tr "repo.pulls.stack_insert_none"}}</p>{{end}}</form>{{end}}
				<form class="ui form" method="post" action="{{.RepoLink}}/pulls/stacks/{{$data.Stack.ID}}/unstack"><input type="hidden" name="stack_version" value="{{$data.Stack.Revision}}"><button type="submit" class="ui basic red button">{{ctx.Locale.Tr "repo.pulls.unstack"}}</button></form>
				{{end}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
