{{if .Entry}}
	{{$label := ctx.Locale.Tr .LocaleKey (printf "#%d %s" .Entry.Pull.Index .Entry.Pull.Issue.Title)}}
	<a class="ui small icon button" href="{{.Entry.Pull.Issue.Link}}" aria-label="{{$label}}" data-tooltip-content="{{$label}}" data-shortcut-keys="{{.Key}}" aria-keyshortcuts="{{.Key}}">{{svg .Icon}}</a>
{{else}}
	<button type="button" class="ui small icon button" disabled aria-hidden="true">{{svg .Icon}}</button>
{{end}}
